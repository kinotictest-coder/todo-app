# Kinotic gateway the UI connects to.
# The platform injects these at deploy time; for local `vite dev` copy this file to
# `.env.local` and point it at the server your project is deployed on.
VITE_KINOTIC_HOST=api.kinotic.ai
VITE_KINOTIC_PORT=443
VITE_KINOTIC_USE_SSL=true

# Optional — default to the project's own org/app.
# VITE_KINOTIC_ORG_ID=minds
# VITE_KINOTIC_APP_ID=todo-app
